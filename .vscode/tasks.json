{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Quantum Engine",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/mingw32-make.exe",
            "args": ["-C", "build", "-j4"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "dependsOn": ["Configure CMake"]
        },
        {
            "label": "Configure CMake",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B", "build",
                "-G", "MinGW Makefiles",
                "-DCUDA_ARCHITECTURES=86",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_CXX_COMPILER=C:/msys64/ucrt64/bin/g++.exe",
                "-DCMAKE_C_COMPILER=C:/msys64/ucrt64/bin/gcc.exe",
                "-DCUDA_TOOLKIT_ROOT_DIR=C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.x"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run Simulation",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/python.exe",
            "args": ["python/examples/basic_simulation.py"],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}